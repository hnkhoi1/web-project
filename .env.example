APP_NAME="Tra cứu Luật Hình sự"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=vi
LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hinh_su
DB_USERNAME=hinh_su
DB_PASSWORD=hinh_su_dev_password
DB_ROOT_PASSWORD=root_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (password reset links).
# Dev: the `mailpit` container catches every mail; read them at http://localhost:8025.
# Production: replace these with your SMTP account, e.g. Gmail (needs 2-step verification
# and an "App password", never the real account password):
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<16-char app password>
#   MAIL_FROM_ADDRESS=you@gmail.com
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker
UID=1000
# Account promoted to admin by `php artisan db:seed --class=AdminSeeder` (register it first).
ADMIN_EMAIL=
WEB_PORT=8080
TRUSTED_PROXIES=*
VITE_HMR_HOST=localhost

# Semantic search is off: measured quality did not beat lexical search.
# Enabling it needs `docker compose --profile semantic up -d`, then
# `docker compose exec app php artisan search:embed`, and about 1 GB of RAM.
SEARCH_BLEND_ENABLED=false
EMBEDDER_URL=http://embedder:8000
